PREHOOK: query: explain vectorization only operator
select f.k1, f.k2, count(*), sum(f.v), sum(f.d), sum(f.dw), max(f.s), min(f.ts), max(f.x), count(f.b), max(f.dt),
  max(m.w)
from cs_fact f join cs_dim m on f.k1 = m.k1 and f.k2 = m.k2
group by f.k1, f.k2
order by f.k1, f.k2
