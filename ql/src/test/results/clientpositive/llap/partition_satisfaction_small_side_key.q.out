PREHOOK: query: explain
select g.k, g.s, length(g.p), d.x, b.name
from (select k, sum(v) s, max(pad) p from f_sk group by k) g join (select x, k from d_sk) d on g.k = d.k
join b_sk b on d.x = b.x
