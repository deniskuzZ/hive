PREHOOK: query: CREATE EXTERNAL TABLE llap_native_orders (
  orderid INT,
  quantity BIGINT,
  price DECIMAL(7,2),
  total DECIMAL(20,2),
  item STRING,
  orderdate DATE,
  tradets TIMESTAMP,
  shipped BOOLEAN,
  region STRING)
PARTITIONED BY SPEC (region, bucket(4, orderid))
STORED BY ICEBERG STORED AS PARQUET
TBLPROPERTIES ('format-version'='2')
